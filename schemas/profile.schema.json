{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kappa-box.invalid/schemas/profile.schema.json",
  "title": "kappa-box profile registration v1",
  "description": "A pre-registered profile declaration. acceptance is evidence-backed state and starts as unverified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "hostClass",
    "tier",
    "acceptance",
    "runtime",
    "policy",
    "limits",
    "channels",
    "expectedFacts",
    "pins",
    "probe"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:(?:l[123]|managed|obs)(?:@[a-z0-9][a-z0-9._-]*)?$"
    },
    "hostClass": {
      "enum": ["wsl2", "linux", "remote", "winmxc"]
    },
    "tier": {
      "enum": ["l1", "l2", "l3", "managed", "obs"]
    },
    "variant": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "acceptance": {
      "enum": ["unverified", "verifying", "verified", "failed", "stale"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "name", "rootless"],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rootless": {
          "type": ["boolean", "null"]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landlockCompatibility", "networkProfiles", "grants"],
      "properties": {
        "landlockCompatibility": {
          "enum": ["hard_requirement", "best_effort"]
        },
        "networkProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memoryBytes", "pids"],
      "properties": {
        "cpu": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "memoryBytes": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "pids": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longLivedProcess", "pty", "separateStdoutStderr", "maxArtifactBytes", "snapshot"],
      "properties": {
        "longLivedProcess": {
          "type": ["boolean", "null"]
        },
        "pty": {
          "type": ["boolean", "null"]
        },
        "separateStdoutStderr": {
          "type": ["boolean", "null"]
        },
        "maxArtifactBytes": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "snapshot": {
          "enum": ["stable", "live_copy", "unsupported", null]
        }
      }
    },
    "expectedFacts": {
      "anyOf": [
        {
          "$ref": "facts.schema.json#/$defs/canonicalFacts"
        },
        {
          "type": "null"
        }
      ]
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "distribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kernel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gateway": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "supervisor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "image": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteVersion", "lastRunAt", "result"],
      "properties": {
        "suiteVersion": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "lastRunAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "result": {
          "enum": ["never_run", "pass", "fail"]
        },
        "failureGroups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "evidenceRef": {
          "type": ["string", "null"],
          "maxLength": 1024
        }
      }
    }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode"],
      "properties": {
        "path": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^/(?:[^/]+/)*[^/]*$",
              "maxLength": 1024
            },
            {
              "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
            }
          ]
        },
        "mode": {
          "enum": ["ro", "rw"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"id": {"pattern": "^[^@]+$"}}},
      "then": {"not": {"required": ["variant"]}}
    },
    {
      "if": {"properties": {"id": {"pattern": "@"}}},
      "then": {"required": ["variant"]}
    },
    {
      "if": {"properties": {"id": {"pattern": "^wsl2:"}}},
      "then": {"properties": {"hostClass": {"const": "wsl2"}}}
    },
    {
      "if": {"properties": {"id": {"pattern": "^linux:"}}},
      "then": {"properties": {"hostClass": {"const": "linux"}}}
    },
    {
      "if": {"properties": {"id": {"pattern": "^remote:"}}},
      "then": {"properties": {"hostClass": {"const": "remote"}}}
    },
    {
      "if": {"properties": {"id": {"pattern": "^winmxc:"}}},
      "then": {"properties": {"hostClass": {"const": "winmxc"}}}
    },
    {
      "if": {"properties": {"id": {"pattern": "^[^:]+:l1(?:@|$)"}}},
      "then": {"properties": {"tier": {"const": "l1"}}}
    },
    {
      "if": {"properties": {"id": {"pattern": "^[^:]+:l2(?:@|$)"}}},
      "then": {"properties": {"tier": {"const": "l2"}}}
    },
    {
      "if": {"properties": {"id": {"pattern": "^[^:]+:l3(?:@|$)"}}},
      "then": {"properties": {"tier": {"const": "l3"}}}
    },
    {
      "if": {"properties": {"id": {"pattern": "^[^:]+:managed(?:@|$)"}}},
      "then": {"properties": {"tier": {"const": "managed"}}}
    },
    {
      "if": {"properties": {"id": {"pattern": "^[^:]+:obs(?:@|$)"}}},
      "then": {"properties": {"tier": {"const": "obs"}}}
    },
    {
      "if": {"properties": {"id": {"const": "wsl2:l1@openshell-docker"}}},
      "then": {"properties": {"variant": {"const": "openshell-docker"}}}
    },
    {
      "if": {"properties": {"acceptance": {"const": "verified"}}},
      "then": {
        "required": ["expectedFacts", "pins", "probe"],
        "properties": {
          "runtime": {
            "properties": {
              "rootless": {"type": "boolean"}
            }
          },
          "channels": {
            "properties": {
              "longLivedProcess": {"type": "boolean"},
              "pty": {"type": "boolean"},
              "separateStdoutStderr": {"type": "boolean"},
              "maxArtifactBytes": {"type": "integer", "minimum": 1},
              "snapshot": {"enum": ["stable", "live_copy", "unsupported"]}
            }
          },
          "expectedFacts": {
            "$ref": "facts.schema.json#/$defs/canonicalFacts"
          },
          "pins": {
            "required": ["host", "distribution", "kernel", "engine", "runtime", "gateway", "supervisor", "image"]
          },
          "probe": {
            "required": ["suiteVersion", "lastRunAt", "evidenceRef"],
            "properties": {
              "suiteVersion": {"type": "string", "minLength": 1},
              "lastRunAt": {"type": "string", "minLength": 1},
              "evidenceRef": {"type": "string", "minLength": 1},
              "result": {"const": "pass"},
              "failureGroups": {"maxItems": 0},
              "lastRunAt": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  ]
}
